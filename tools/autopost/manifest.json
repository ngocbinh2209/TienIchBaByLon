{
  "manifest_version": 3,
  "name": "BinhStar GF",
  "version": "1.2.0",
  "description": "Quét và hỗ trợ đăng nội dung lần lượt vào các nhóm Facebook đang hiển thị.",
  "permissions": ["storage", "tabs", "notifications", "unlimitedStorage", "debugger"],
  "host_permissions": ["https://www.facebook.com/*"],
  "action": {
    "default_title": "BinhStar GF",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
