{
  "manifest_version": 3,
  "name": "Tích Bạn Bè Vô Group",
  "version": "1.1.0",
  "description": "Tự động lọc và tick người có thể gửi lời mời vào group Facebook. Bạn tự bấm Gửi lời mời.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://facebook.com/*",
    "https://www.facebook.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tích Bạn Bè Vô Group"
  },
  "content_scripts": [
    {
      "matches": [
        "https://facebook.com/*",
        "https://www.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
